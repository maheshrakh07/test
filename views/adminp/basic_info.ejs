<%- include("navbar.ejs") %>

<!-- Bootstrap CSS (Add in your layout if not already added) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container " style="margin-left: 450px; width: 700px; padding-top: 100px;">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h4 class="mb-0">Contact Information</h4>
        </div>
        <div class="card-body p-4">
            <form action="/admin/save_info" method="post">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Mobile</label>
                        <input type="number" name="mobile_no" value="<%= data[0].mobile_no %>" class="form-control" placeholder="Enter mobile number" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="email"value="<%= data[0].email %>" name="email" class="form-control" placeholder="Enter email" required>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Address</label>
                        <input type="text"value="<%= data[0].address %>" name="address" class="form-control" placeholder="Enter address">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Facebook Link</label>
                        <input type="text" value="<%= data[0].facebook_link %>" name="facebook_link" class="form-control" placeholder="Facebook profile URL">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Twitter Link</label>
                        <input type="text"value="<%= data[0].twitter_link %>" name="twitter_link" class="form-control" placeholder="Twitter profile URL">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">LinkedIn Link</label>
                        <input type="text"value="<%= data[0].linkedin_link %>" name="linkedin_link" class="form-control" placeholder="LinkedIn profile URL">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Instagram Link</label>
                        <input type="text"value="<%= data[0].instagram_link %>" name="instagram_link" class="form-control" placeholder="Instagram profile URL">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Location</label>
                        <input type="text"value="<%= data[0].location %>" name="location" class="form-control" placeholder="Enter location">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Heading</label>
                        <input type="text"value="<%= data[0].heading %>" name="heading" class="form-control" placeholder="Enter heading">
                    </div>

                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill">
                        Save Information
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<%- include("footer.ejs") %>
